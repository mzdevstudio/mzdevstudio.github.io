# VITE_CONTACT_EMAIL: Destination inbox for the contact form (FormSubmit.co).
# On the first submission FormSubmit sends an activation link to this address;
# click it once and all subsequent form messages are delivered there.
# Defaults to mzdrowy@gmail.com when unset.
VITE_CONTACT_EMAIL="mzdrowy@gmail.com"

# VITE_SITE_URL: Canonical production URL used in dynamic metadata/JSON-LD.
# Leave unset to automatically match the live deployment origin (e.g. *.pages.dev or custom domain).
# VITE_SITE_URL="https://mzdevstudio.pl"

# VITE_BASE_PATH: Base URL path (e.g. "/mzdevstudio/" for GitHub Pages subpath, "/" for root domain).
# VITE_BASE_PATH="/"

# VITE_SITE_NOINDEX: Set to "true" to emit noindex,nofollow on temporary preview deployments.
# VITE_SITE_NOINDEX="false"
